{
  "mcpServers": {
    "overleaf": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--no-dev",
        "--no-editable",
        "--no-env-file",
        "--project",
        "server",
        "overleaf-mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "CODEX_SECRETS_DIR"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300,
      "default_tools_approval_mode": "auto",
      "tools": {
        "overleaf_edit_text_file": {
          "approval_mode": "prompt"
        },
        "overleaf_write_text_file": {
          "approval_mode": "prompt"
        },
        "overleaf_import_file": {
          "approval_mode": "prompt"
        },
        "overleaf_move_file": {
          "approval_mode": "prompt"
        },
        "overleaf_delete_file": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
