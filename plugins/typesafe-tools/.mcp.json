{
  "mcpServers": {
    "typesafe": {
      "command": "uv",
      "args": ["run", "--frozen", "--no-dev", "--no-editable", "--no-env-file", "--project", "server", "typesafe-mcp"],
      "cwd": ".",
      "env_vars": ["CODEX_HOME", "CODEX_SECRETS_DIR"],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 45,
      "default_tools_approval_mode": "auto"
    }
  }
}
