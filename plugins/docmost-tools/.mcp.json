{
  "mcpServers": {
    "docmost": {
      "command": "/bin/bash",
      "args": [
        "server/scripts/docmost-mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_SECRETS_DIR",
        "CODEX_HOME"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 900,
      "default_tools_approval_mode": "auto",
      "tools": {
        "docmost_create_page": {
          "approval_mode": "prompt"
        },
        "docmost_update_page_title": {
          "approval_mode": "prompt"
        },
        "docmost_create_comment": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
