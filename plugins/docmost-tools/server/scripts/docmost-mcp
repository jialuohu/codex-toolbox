#!/usr/bin/env bash
# Start the Docmost MCP from the immutable runtime matching this plugin source.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
SERVER_DIR="$(cd "$SELF_DIR/.." && pwd)"
SELF="$SELF_DIR/docmost-mcp"
DOCMOST_CODEX_ROOT="$(printenv CODEX_HOME 2>/dev/null || true)"
if [ -z "$DOCMOST_CODEX_ROOT" ]; then
  DOCMOST_CODEX_ROOT="$HOME/.codex"
fi
DOCMOST_SECRETS_ROOT="$(printenv CODEX_SECRETS_DIR 2>/dev/null || true)"
if [ -z "$DOCMOST_SECRETS_ROOT" ]; then
  DOCMOST_SECRETS_ROOT="$DOCMOST_CODEX_ROOT/secrets"
fi
RUNTIME_PARENT="$DOCMOST_CODEX_ROOT/runtime"
GENERATION_ROOT="$RUNTIME_PARENT/docmost-tools-generations"
GENERATION_ENVS="$GENERATION_ROOT/envs"
SECRET_FILE="$DOCMOST_SECRETS_ROOT/docmost.env"
LOCK_SOURCE="$SERVER_DIR/src/docmost_tools/runtime_lock.py"
STAMP_SOURCE="$SERVER_DIR/src/docmost_tools/runtime_stamp.py"
SYSTEM_PYTHON="$(command -v python3 || true)"
readonly SELF_DIR SERVER_DIR SELF DOCMOST_CODEX_ROOT DOCMOST_SECRETS_ROOT
readonly RUNTIME_PARENT GENERATION_ROOT GENERATION_ENVS SECRET_FILE
readonly LOCK_SOURCE STAMP_SOURCE SYSTEM_PYTHON

fail() {
  echo "$*" >&2
  exit 1
}

file_mode() {
  local mode
  if mode="$(stat -f '%Lp' "$1" 2>/dev/null)"; then
    printf '%s\n' "$mode"
    return 0
  fi
  stat -c '%a' "$1" 2>/dev/null
}

require_safe_source() {
  [ -n "$SYSTEM_PYTHON" ] || fail "python3 is required for the Docmost runtime"
  [ -d "$SERVER_DIR" ] && [ ! -L "$SERVER_DIR" ] || \
    fail "Docmost plugin server directory is missing or unsafe"
  [ -f "$LOCK_SOURCE" ] && [ ! -L "$LOCK_SOURCE" ] || \
    fail "Docmost runtime lock helper is missing or unsafe"
  [ -f "$STAMP_SOURCE" ] && [ ! -L "$STAMP_SOURCE" ] || \
    fail "Docmost runtime fingerprint helper is missing or unsafe"
}

require_safe_roots() {
  [ -d "$RUNTIME_PARENT" ] && [ ! -L "$RUNTIME_PARENT" ] || \
    fail "Docmost runtime is missing or unsafe; rerun the full codex-toolbox setup from its checkout"
  [ -d "$GENERATION_ROOT" ] && [ ! -L "$GENERATION_ROOT" ] || \
    fail "Docmost runtime is missing or unsafe; rerun the full codex-toolbox setup from its checkout"
  [ -d "$GENERATION_ENVS" ] && [ ! -L "$GENERATION_ENVS" ] || \
    fail "Docmost runtime is missing or unsafe; rerun the full codex-toolbox setup from its checkout"
  [ -d "$GENERATION_ROOT/locks" ] && [ ! -L "$GENERATION_ROOT/locks" ] || \
    fail "Docmost runtime is missing or unsafe; rerun the full codex-toolbox setup from its checkout"
}

require_private_env() {
  [ -f "$SECRET_FILE" ] || fail "Missing safe CODEX_SECRETS_DIR/docmost.env"
  [ ! -L "$SECRET_FILE" ] || fail "Missing safe CODEX_SECRETS_DIR/docmost.env"
  local mode
  mode="$(file_mode "$SECRET_FILE")" || fail "Unable to inspect CODEX_SECRETS_DIR/docmost.env"
  [ "$mode" = "600" ] || fail "CODEX_SECRETS_DIR/docmost.env must have mode 600"
}

source_fingerprint() {
  local value
  value="$("$SYSTEM_PYTHON" "$STAMP_SOURCE" fingerprint "$SERVER_DIR")" || \
    fail "Docmost runtime fingerprint is unavailable; rerun the full codex-toolbox setup from its checkout"
  case "$value" in
    (*[!0-9a-f]*|'') fail "Docmost runtime fingerprint is invalid" ;;
  esac
  [ "$(printf '%s' "$value" | wc -c | tr -d ' ')" = 64 ] || \
    fail "Docmost runtime fingerprint is invalid"
  printf '%s\n' "$value"
}

require_safe_source
require_safe_roots
require_private_env

if [ "$#" -eq 0 ]; then
  FINGERPRINT="$(source_fingerprint)"
  readonly FINGERPRINT
  exec "$SYSTEM_PYTHON" "$LOCK_SOURCE" \
    --kind session --mode shared --root "$RUNTIME_PARENT" -- \
    "$SYSTEM_PYTHON" "$LOCK_SOURCE" \
      --kind generation --mode shared --root "$GENERATION_ROOT" \
      --generation "$FINGERPRINT" -- \
      /bin/bash "$SELF" --locked "$FINGERPRINT"
fi

[ "$#" -eq 2 ] && [ "$1" = "--locked" ] || fail "Docmost MCP launcher arguments are invalid"
FINGERPRINT="$2"
case "$FINGERPRINT" in
  (*[!0-9a-f]*|'') fail "Docmost runtime fingerprint is invalid" ;;
esac
[ "$(printf '%s' "$FINGERPRINT" | wc -c | tr -d ' ')" = 64 ] || \
  fail "Docmost runtime fingerprint is invalid"
readonly FINGERPRINT

[ "$(printenv DOCMOST_RUNTIME_LOCK_MODE 2>/dev/null || true)" = "shared" ] || \
  fail "Docmost MCP requires the held shared session lock"
[ "$(printenv DOCMOST_GENERATION_LOCK_MODE 2>/dev/null || true)" = "shared" ] || \
  fail "Docmost MCP requires the held shared generation lock"
[ "$(printenv DOCMOST_GENERATION_ID 2>/dev/null || true)" = "$FINGERPRINT" ] || \
  fail "Docmost MCP generation lock does not match its source"
"$SYSTEM_PYTHON" "$LOCK_SOURCE" --validate-fd \
  --kind session --mode shared --root "$RUNTIME_PARENT" || \
  fail "Docmost MCP session lock validation failed"
"$SYSTEM_PYTHON" "$LOCK_SOURCE" --validate-fd \
  --kind generation --mode shared --root "$GENERATION_ROOT" \
  --generation "$FINGERPRINT" || \
  fail "Docmost MCP generation lock validation failed"

[ "$(source_fingerprint)" = "$FINGERPRINT" ] || \
  fail "Docmost source changed during startup; reconnect Docmost"
GENERATION_RUNTIME="$GENERATION_ENVS/$FINGERPRINT"
RUNTIME_STAMP="$GENERATION_RUNTIME/.docmost-tools-source.sha256"
MCP_EXECUTABLE="$GENERATION_RUNTIME/bin/docmost-mcp"
readonly GENERATION_RUNTIME RUNTIME_STAMP MCP_EXECUTABLE
[ -d "$GENERATION_RUNTIME" ] && [ ! -L "$GENERATION_RUNTIME" ] || \
  fail "Docmost runtime is stale; rerun the full codex-toolbox setup from its checkout"
"$SYSTEM_PYTHON" "$STAMP_SOURCE" check "$SERVER_DIR" "$RUNTIME_STAMP" >/dev/null 2>&1 || \
  fail "Docmost runtime is stale; rerun the full codex-toolbox setup from its checkout"
[ -x "$MCP_EXECUTABLE" ] && [ ! -L "$MCP_EXECUTABLE" ] || \
  fail "Docmost runtime is incomplete; rerun the full codex-toolbox setup from its checkout"

CODEX_SECRETS_DIR="$DOCMOST_SECRETS_ROOT"
readonly CODEX_SECRETS_DIR
export CODEX_SECRETS_DIR
set -a
# shellcheck disable=SC1090
source "$SECRET_FILE"
set +a
unset PYTHONPATH VIRTUAL_ENV
exec "$MCP_EXECUTABLE"
