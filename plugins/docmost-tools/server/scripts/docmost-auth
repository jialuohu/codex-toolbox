#!/usr/bin/env bash
# Stable wrapper for one immutable Docmost authentication runtime generation.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
SELF="$SELF_DIR/docmost-auth"
RUNTIME_ROOT="$(cd "$SELF_DIR/.." && pwd)"
GENERATION_ENVS="$(cd "$RUNTIME_ROOT/.." && pwd)"
GENERATION_ROOT="$(cd "$GENERATION_ENVS/.." && pwd)"
RUNTIME_PARENT="$(cd "$GENERATION_ROOT/.." && pwd)"
GENERATION_ID="$(basename "$RUNTIME_ROOT")"
DOCMOST_CODEX_ROOT="$(printenv CODEX_HOME 2>/dev/null || true)"
if [ -z "$DOCMOST_CODEX_ROOT" ]; then
  DOCMOST_CODEX_ROOT="$HOME/.codex"
fi
DOCMOST_SECRETS_ROOT="$(printenv CODEX_SECRETS_DIR 2>/dev/null || true)"
if [ -z "$DOCMOST_SECRETS_ROOT" ]; then
  DOCMOST_SECRETS_ROOT="$DOCMOST_CODEX_ROOT/secrets"
fi
DOCMOST_ENV_FILE="$DOCMOST_SECRETS_ROOT/docmost.env"
DOCMOST_AUTH_INTERNAL="$RUNTIME_ROOT/bin/docmost-auth-internal"
DOCMOST_RUNTIME_LOCK="$RUNTIME_ROOT/bin/docmost-runtime-lock"
readonly SELF_DIR SELF RUNTIME_ROOT GENERATION_ENVS GENERATION_ROOT RUNTIME_PARENT
readonly GENERATION_ID DOCMOST_CODEX_ROOT DOCMOST_SECRETS_ROOT DOCMOST_ENV_FILE
readonly DOCMOST_AUTH_INTERNAL DOCMOST_RUNTIME_LOCK

fail() {
  echo "$*" >&2
  exit 1
}

file_mode() {
  local mode
  if mode="$(stat -f '%Lp' "$1" 2>/dev/null)"; then
    printf '%s\n' "$mode"
    return 0
  fi
  stat -c '%a' "$1" 2>/dev/null
}

[ "$#" -eq 1 ] || fail "Usage: docmost-auth login|status|logout"
case "$GENERATION_ID" in
  (*[!0-9a-f]*|'') fail "Docmost authentication runtime generation is invalid" ;;
esac
[ "$(printf '%s' "$GENERATION_ID" | wc -c | tr -d ' ')" = 64 ] || \
  fail "Docmost authentication runtime generation is invalid"
[ "$GENERATION_ENVS" = "$GENERATION_ROOT/envs" ] || \
  fail "Docmost authentication runtime layout is invalid"
[ "$RUNTIME_PARENT" = "$DOCMOST_CODEX_ROOT/runtime" ] || \
  fail "Docmost authentication runtime escapes CODEX_HOME"
[ -d "$RUNTIME_ROOT" ] && [ ! -L "$RUNTIME_ROOT" ] || \
  fail "Docmost authentication runtime is missing or unsafe"
[ -x "$DOCMOST_RUNTIME_LOCK" ] && [ ! -L "$DOCMOST_RUNTIME_LOCK" ] || \
  fail "Docmost authentication runtime lock is missing or unsafe"

case "$1" in
  status) REQUIRED_SESSION_MODE=shared ;;
  login|logout) REQUIRED_SESSION_MODE=exclusive ;;
  *) fail "Usage: docmost-auth login|status|logout" ;;
esac
readonly REQUIRED_SESSION_MODE

SESSION_MODE="$(printenv DOCMOST_RUNTIME_LOCK_MODE 2>/dev/null || true)"
SESSION_FD="$(printenv DOCMOST_RUNTIME_LOCK_FD 2>/dev/null || true)"
GENERATION_MODE="$(printenv DOCMOST_GENERATION_LOCK_MODE 2>/dev/null || true)"
GENERATION_FD="$(printenv DOCMOST_GENERATION_LOCK_FD 2>/dev/null || true)"
HELD_GENERATION="$(printenv DOCMOST_GENERATION_ID 2>/dev/null || true)"
readonly SESSION_MODE SESSION_FD GENERATION_MODE GENERATION_FD HELD_GENERATION

if [ -z "$SESSION_MODE$SESSION_FD$GENERATION_MODE$GENERATION_FD$HELD_GENERATION" ]; then
  exec "$DOCMOST_RUNTIME_LOCK" \
    --kind session --mode "$REQUIRED_SESSION_MODE" --root "$RUNTIME_PARENT" -- \
    "$DOCMOST_RUNTIME_LOCK" \
      --kind generation --mode shared --root "$GENERATION_ROOT" \
      --generation "$GENERATION_ID" -- \
      "$SELF" "$@"
fi

[ "$SESSION_MODE" = "$REQUIRED_SESSION_MODE" ] || \
  fail "Docmost $1 requires the held $REQUIRED_SESSION_MODE session lock"
[ "$GENERATION_MODE" = "shared" ] && [ "$HELD_GENERATION" = "$GENERATION_ID" ] || \
  fail "Docmost $1 requires the held shared generation lock"
"$DOCMOST_RUNTIME_LOCK" --validate-fd \
  --kind session --mode "$REQUIRED_SESSION_MODE" --root "$RUNTIME_PARENT" || \
  fail "Docmost $1 requires a valid held $REQUIRED_SESSION_MODE session lock"
"$DOCMOST_RUNTIME_LOCK" --validate-fd \
  --kind generation --mode shared --root "$GENERATION_ROOT" \
  --generation "$GENERATION_ID" || \
  fail "Docmost $1 requires a valid held shared generation lock"

case "$1" in
  login|status)
    [ -f "$DOCMOST_ENV_FILE" ] || fail "Missing CODEX_SECRETS_DIR/docmost.env"
    [ ! -L "$DOCMOST_ENV_FILE" ] || fail "docmost.env must not be a symlink"
    DOCMOST_ENV_MODE="$(file_mode "$DOCMOST_ENV_FILE")" || \
      fail "Unable to inspect docmost.env permissions"
    [ "$DOCMOST_ENV_MODE" = "600" ] || fail "docmost.env must have mode 600"
    readonly DOCMOST_ENV_MODE
    CODEX_SECRETS_DIR="$DOCMOST_SECRETS_ROOT"
    readonly CODEX_SECRETS_DIR
    export CODEX_SECRETS_DIR
    set -a
    # shellcheck disable=SC1090
    source "$DOCMOST_ENV_FILE"
    set +a
    ;;
  logout)
    CODEX_SECRETS_DIR="$DOCMOST_SECRETS_ROOT"
    readonly CODEX_SECRETS_DIR
    export CODEX_SECRETS_DIR
    ;;
  *) fail "Usage: docmost-auth login|status|logout" ;;
esac

[ -x "$DOCMOST_AUTH_INTERNAL" ] && [ ! -L "$DOCMOST_AUTH_INTERNAL" ] || \
  fail "Docmost auth runtime is incomplete; rerun the full codex-toolbox setup from its checkout"
unset PYTHONPATH VIRTUAL_ENV
exec "$DOCMOST_AUTH_INTERNAL" "$@"
